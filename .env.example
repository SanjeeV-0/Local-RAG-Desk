# Application
APP_NAME=Production AI Research & Knowledge Agent
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# -----------------------------
# OpenRouter - Common
# -----------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Production AI Research & Knowledge Agent
# Shared client-level settings for BOTH the decomposition and generation
# providers (connection/transport, not a per-task sampling choice).
# Leave blank to use the openai SDK's own default timeout; openai SDK
# already retries retryable errors internally (no custom retry loop here).
OPENROUTER_TIMEOUT_SECONDS=
OPENROUTER_MAX_RETRIES=2

# -----------------------------
# Query decomposition
# -----------------------------
OPENROUTER_DECOMPOSITION_MODEL=meta-llama/llama-3.3-8b-instruct:free
OPENROUTER_DECOMPOSITION_TEMPERATURE=0.0
OPENROUTER_DECOMPOSITION_MAX_TOKENS=
OPENROUTER_DECOMPOSITION_TOP_P=1.0
OPENROUTER_DECOMPOSITION_RESPONSE_FORMAT=
OPENROUTER_DECOMPOSITION_REASONING_EFFORT=
# OpenRouter-specific passthrough (sent via extra_body, not every model
# supports it) -- leave blank to omit entirely.
OPENROUTER_DECOMPOSITION_TOP_K=
# Standard OpenAI fields, valid range -2.0 to 2.0 -- leave blank to omit.
OPENROUTER_DECOMPOSITION_FREQUENCY_PENALTY=
OPENROUTER_DECOMPOSITION_PRESENCE_PENALTY=

# -----------------------------
# Answer generation
# -----------------------------
OPENROUTER_GENERATION_MODEL=meta-llama/llama-3.3-8b-instruct:free
OPENROUTER_GENERATION_TEMPERATURE=0.2
OPENROUTER_GENERATION_MAX_TOKENS=
OPENROUTER_GENERATION_TOP_P=1.0
OPENROUTER_GENERATION_RESPONSE_FORMAT=
OPENROUTER_GENERATION_REASONING_EFFORT=
# OpenRouter-specific passthrough (sent via extra_body, not every model
# supports it) -- leave blank to omit entirely. Independent of the
# decomposition value above -- the two tasks are never cross-wired.
OPENROUTER_GENERATION_TOP_K=
# Standard OpenAI fields, valid range -2.0 to 2.0 -- leave blank to omit.
OPENROUTER_GENERATION_FREQUENCY_PENALTY=
OPENROUTER_GENERATION_PRESENCE_PENALTY=

# -----------------------------
# pgvector HNSW query-time configuration
# -----------------------------
# All four are query-time GUCs only -- none of these change the HNSW
# index's build parameters (m, ef_construction). Leave blank to use
# pgvector's own built-in defaults (shown in comments) unchanged. Applied
# via a per-transaction SET LOCAL that cannot leak across pooled
# connections (see app.core.repositories.document.DocumentRepository).
# pgvector default: 40
HNSW_EF_SEARCH=
# off | relaxed_order | strict_order -- pgvector default: off
HNSW_ITERATIVE_SCAN=
# pgvector default: 20000
HNSW_MAX_SCAN_TUPLES=
# pgvector default: 1 (valid range 1-1000)
HNSW_SCAN_MEM_MULTIPLIER=

# -----------------------------
# Retrieval / reranking operational controls
# -----------------------------
# Each default below is the exact value this project previously
# hard-coded -- leaving these unset changes nothing.
# Application-level candidate-pool floor (NOT the HNSW search breadth
# above, and NOT the final result count below).
RETRIEVAL_CANDIDATE_LIMIT_FLOOR=50
# Final result count for POST /research/ask specifically (POST
# /retrieval/search already exposes an equivalent per-request `limit`).
RESEARCH_ASK_RESULT_LIMIT=10
# Hard ceiling on kept sub-queries (including the original query).
QUERY_DECOMPOSITION_MAX_SUB_QUERIES=5


# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/research_agent
